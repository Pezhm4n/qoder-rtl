{
  "name": "qoder-persian-rtl",
  "version": "1.10.0",
  "description": "Persian/Arabic RTL + Vazirmatn for the Qoder desktop app: CDP live injection by default (no install files touched), archive patch kept behind an explicit command",
  "keywords": [
    "qoder",
    "rtl",
    "persian",
    "farsi",
    "arabic",
    "vazirmatn",
    "electron",
    "devtools-protocol",
    "asar",
    "patcher"
  ],
  "license": "MIT",
  "main": "live.js",
  "bin": {
    "qoder-rtl": "cli.js",
    "qoder-persian-rtl": "cli.js"
  },
  "files": [
    "cli.js",
    "index.js",
    "live.js",
    "lib",
    "patches",
    "assets",
    "README.md"
  ],
  "scripts": {
    "start": "node cli.js start",
    "check": "node cli.js check",
    "status": "node cli.js status",
    "live": "node live.js",
    "live:check": "node live.js --check",
    "live:launcher": "node live.js --launcher",
    "patch": "node index.js",
    "verify": "node index.js --verify",
    "restore": "node index.js --restore",
    "asar:status": "node index.js --status",
    "test": "node test/roundtrip.js && node test/live.js && node test/cli.js && node test/archive.js",
    "test:browser": "node test/browser.js"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
